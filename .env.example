# Copy to .env (gitignored) and fill in. Real environment variables win over this file.
# `npm run check-secrets` (also a pre-commit hook) blocks commits that contain key-shaped strings.

# --- NVIDIA Nemotron (agent)
# Hosted: key from https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# Fully local instead (Ollama on this laptop; no key needed):
# NEMOTRON_BASE_URL=http://localhost:11434/v1
# NEMOTRON_MODEL=nemotron-3-nano
NEMOTRON_THINKING=0
NEMOTRON_TIMEOUT=90

# --- Google Gemini (caregiver "Catch me up" briefings) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Photon 2.0 (iMessage) -- app.beta.photon.codes -> API keys (project:read + project:write)
# Leave blank for simulated texting.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# --- Maritime (always-on cloud box: python scripts/maritime_deploy.py up)
MARITIME_API_KEY=
SPACETIME_CLOUD_DB=blinktalk-neal

# --- SpacetimeDB (local: ws://localhost:3000, Maincloud: wss://maincloud.spacetimedb.com)
SPACETIME_URI=ws://localhost:3000
SPACETIME_DB=blinktalk
BLINKTALK_PATIENT=neal
