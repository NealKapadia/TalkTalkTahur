{
  "name": "blinktalk",
  "private": true,
  "description": "BlinkTalk: eye-movement communication with a SpacetimeDB backend, Photon iMessage and an AI agent",
  "workspaces": [
    "spacetime",
    "hub",
    "dashboard"
  ],
  "scripts": {
    "test": "npm test -w spacetime && npm test -w hub",
    "hub": "npm start -w hub",
    "dashboard": "npm run dev -w dashboard",
    "check-secrets": "node scripts/check-secrets.mjs",
    "e2e": "node --import tsx scripts/e2e.ts",
    "photon-check": "node --import tsx scripts/photon-check.ts",
    "llm-check": "node --import tsx scripts/llm-check.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
