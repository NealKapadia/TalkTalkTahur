{
  "task": "BlinkTalk eye-gesture classification from EOG recorded on the AFE4950 ECG channel",
  "classes": [
    "blink",
    "left",
    "none",
    "right"
  ],
  "features": [
    "slope_at_onset",
    "level_pre",
    "level_post",
    "step_short",
    "loc_min",
    "loc_max",
    "loc_t_min_minus_t_max",
    "loc_width_half",
    "slope_max",
    "slope_min",
    "y_min",
    "y_max",
    "ptp",
    "noise_pre"
  ],
  "config": {
    "fs_hz": 500.0,
    "window_s": [
      -0.4,
      0.8
    ],
    "refractory_s": 0.3,
    "slope_k": 6.0,
    "return_s": 1.5,
    "multi_blink_s": 0.8,
    "filters": "60 Hz notch (Q=30) + 10 Hz 2nd-order Butterworth low-pass, zero-phase",
    "units": "mV, mV/s, ms, mV*s"
  },
  "model": "StandardScaler + RandomForestClassifier(n_estimators=80, max_depth=8, class_weight=balanced)",
  "data": {
    "rows": 498,
    "subjects": [
      "neal",
      "person1"
    ],
    "label_counts": {
      "none": 356,
      "blink": 69,
      "left": 37,
      "right": 36
    }
  },
  "evaluation": {
    "split": "leave-one-subject-out cross-validation",
    "folds": 2,
    "events_tested": 498,
    "classifier_only": {
      "accuracy": 0.7791,
